+// Regression coverage for the final prefill chunk, including exact batch boundaries.
+static void check_xattention_dense_tail(size_t prompt_length, size_t dense_tail,
+                                       const std::vector<float>& thresholds) {
+    SchedulerConfig config;
+    config.max_num_batched_tokens = 32;
+    config.num_kv_blocks = 64;
+    config.max_num_seqs = 1;
+    config.enable_prefix_caching = false;
+    config.use_sparse_attention = true;
+    config.sparse_attention_config.mode = SparseAttentionMode::XATTENTION;
+    config.sparse_attention_config.xattention_threshold = 0.3f;
+    config.sparse_attention_config.num_last_dense_tokens_in_prefill = dense_tail;
+    std::vector<uint64_t> tokens(prompt_length, 42);
+    auto group = std::make_shared<SequenceGroup>(0,
+        ov::Tensor(ov::element::i64, {tokens.size()}, tokens.data()), utils::get_greedy_config());
+    const auto seq_id = (*group)[0]->get_id();
+    std::vector<SequenceGroup::Ptr> requests = {group};
+    Scheduler scheduler(init_cache_orchestrator(config), config);
+    for (float expected : thresholds) {
+        const auto output = scheduler.schedule(requests);
+        ASSERT_GT(group->get_num_scheduled_tokens(), 0u);
+        EXPECT_FLOAT_EQ(output.get_xattention_threshold(seq_id), expected);
+        group->finish_iteration();
+    }
+    EXPECT_EQ(group->get_num_processed_tokens(), prompt_length);
+    (*group)[0]->append_token(42, 0.9f);
+    const auto decode = scheduler.schedule(requests);
+    EXPECT_EQ(group->get_num_scheduled_tokens(), 1u);
+    EXPECT_FLOAT_EQ(decode.get_xattention_threshold(seq_id), 0.0f);
+    scheduler.free_sequence(seq_id);
+}
+
+TEST(TestScheduler, xattention_dense_tail_exact_batch_boundary) {
+    check_xattention_dense_tail(128, 8, {0.3f, 0.3f, 0.3f, 1.0f});
+}
+TEST(TestScheduler, xattention_dense_tail_ragged_final_chunk) {
+    check_xattention_dense_tail(132, 8, {0.3f, 0.3f, 0.3f, 1.0f, 1.0f});
+}
+TEST(TestScheduler, xattention_dense_tail_explicitly_disabled) {
+    check_xattention_dense_tail(128, 0, {0.3f, 0.3f, 0.3f, 0.3f});
+}
